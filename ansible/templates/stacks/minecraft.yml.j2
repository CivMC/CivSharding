version: '3.8'

services:

    waterfall:
        image: itzg/mc-proxy:java25
        restart: unless-stopped
        tty: true
        stdin_open: true
        networks:
            - minecraft_default
        ports:
            # Open port in host mode, to bypass swarm ingress
            - target: 8192
              published: 8192
              protocol: tcp
              mode: host
            - target: 25577
              published: 25565
              protocol: tcp
              mode: host
            - target: 25577
              published: 25577
              protocol: udp
              mode: host
        environment:
            VELOCITY_VERSION: '3.5.0-SNAPSHOT'
            TYPE: 'VELOCITY'

            REPLACE_ENV_VARIABLES: 'true'
            REPLACE_ENV_VARIABLE_PREFIX: 'CIV'

            INIT_MEMORY: 3G
            MAX_MEMORY: 4G
            CIV_POSTGRES_HOST: minecraft_postgres
            CIV_POSTGRES_USERNAME: '{{secret.minecraft.postgres.username}}'
            CIV_POSTGRES_PASSWORD: '{{secret.minecraft.postgres.password}}'
            CIV_FORWARDING_SECRET: '{{secret.minecraft.forwarding_secret}}'
            CIV_TIMEOUT_TIME: 30000
            CIV_PVP_HOSTNAME: '{{setting.minecraft.pvp_hostname}}'
            CIV_HOSTNAME: '{{setting.minecraft.hostname}}'

            CIV_RABBITMQ_HOST: minecraft_rabbitmq
            CIV_RABBITMQ_USERNAME: rabbitmq
            CIV_RABBITMQ_PASSWORD: '{{secret.minecraft.rabbitmq.password}}'

            CIV_MYSQL_HOST: minecraft_mariadb
            CIV_MYSQL_USERNAME: '{{secret.minecraft.mysql.username}}'
            CIV_MYSQL_PASSWORD: '{{secret.minecraft.mysql.password}}'
        deploy:
            placement:
                constraints: [node.role == manager]
        volumes:
            # Config & Plugins
            - /opt/stacks/minecraft/proxy-config:/config
            - /opt/stacks/minecraft/proxy-plugins:/plugins

    paper:
        image: itzg/minecraft-server:stable-java25
        restart: unless-stopped
        tty: true
        stdin_open: true
        stop_grace_period: 60m
        networks:
            - minecraft_default
        ports:
            - target: 5004
              published: 5004
              protocol: tcp
              mode: host
        environment:
            TYPE: 'paper'
            VERSION: '1.21.11'
            EULA: 'TRUE'
            PAPER_DOWNLOAD_URL: 'https://api.leafmc.one/v2/projects/leaf/versions/1.21.11/builds/166/downloads/leaf-1.21.11-166.jar'

            REMOVE_OLD_MODS: 'TRUE'
            COPY_CONFIG_DEST: '/data'
            SYNC_SKIP_NEWER_IN_DESTINATION: 'false'
            REPLACE_ENV_DURING_SYNC: 'TRUE'
            REPLACE_ENV_VARIABLE_PREFIX: 'CIV'

            INIT_MEMORY: '{{setting.minecraft.resources.memory}}'
            MAX_MEMORY: '{{setting.minecraft.resources.memory}}'
            USE_MEOWICE_FLAGS: 'TRUE'
            STOP_DURATION: 3600

            CIV_SECUREBOOT_ENABLE: 'true'
            CIV_SERVER_NAME: prod-server
            # The name this shard owns ground and player data under; must match the proxy's server list
            CIV_SHARD_NAME: main
{% if setting.minecraft.whitelist %}
            ENABLE_WHITELIST: 'true'
            CIV_WHITELIST: 'true'
{% else %}
            ENABLE_WHITELIST: 'false'
            CIV_WHITELIST: 'false'
{% endif %}

            CIV_WORLD_GENERATOR: Terra:CIVMC
            CIV_WORDBANK_SEED: '{{secret.minecraft.wordbank_seed}}'
            CIV_HIDDENORE_DENSITY_SEED: '{{ secret.minecraft.zorweth_hiddenore_density_seed }}'
            CIV_HIDDENORE_HEIGHT_SEED: '{{ secret.minecraft.zorweth_hiddenore_height_seed }}'

            CIV_MYSQL_HOST: minecraft_mariadb
            CIV_MYSQL_USERNAME: '{{secret.minecraft.mysql.username}}'
            CIV_MYSQL_PASSWORD: '{{secret.minecraft.mysql.password}}'

            CIV_POSTGRES_HOST: minecraft_postgres
            CIV_POSTGRES_USERNAME: '{{secret.minecraft.postgres.username}}'
            CIV_POSTGRES_PASSWORD: '{{secret.minecraft.postgres.password}}'

            CIV_DATABASE_PREFIX: ''

            CIV_RABBITMQ_HOST: minecraft_rabbitmq
            CIV_RABBITMQ_USERNAME: rabbitmq
            CIV_RABBITMQ_PASSWORD: '{{secret.minecraft.rabbitmq.password}}'

            CIV_WATCHDOG_TIMEOUT_TIME: 60
            CIV_FORWARDING_SECRET: '{{secret.minecraft.forwarding_secret}}'

            JVM_OPTS: '-agentpath:./libti.so'
        volumes:
            # Persistence
            - /opt/stacks/minecraft/paper-data:/data
            # Config & Plugins
            - /opt/stacks/minecraft/paper-config:/config
            - /opt/stacks/minecraft/paper-plugins:/plugins

        deploy:
            placement:
                constraints: [node.role == manager]
            resources:
                limits:
                    memory: '{{setting.minecraft.resources.memory_limit}}'

    # The two shards that share the overworld with `paper` above. Everything but the name and the
    # data directory is deliberately identical: same image, same generator, same seeds, the same
    # config tree and the same plugins, because the ground either side of a border has to be the
    # same ground. Their data directories are copies of paper-data, not fresh worlds.
    northeast:
        image: itzg/minecraft-server:stable-java25
        restart: unless-stopped
        tty: true
        stdin_open: true
        stop_grace_period: 60m
        networks:
            - minecraft_default
        environment:
            TYPE: 'paper'
            VERSION: '1.21.11'
            EULA: 'TRUE'
            PAPER_DOWNLOAD_URL: 'https://api.leafmc.one/v2/projects/leaf/versions/1.21.11/builds/166/downloads/leaf-1.21.11-166.jar'

            REMOVE_OLD_MODS: 'TRUE'
            COPY_CONFIG_DEST: '/data'
            SYNC_SKIP_NEWER_IN_DESTINATION: 'false'
            REPLACE_ENV_DURING_SYNC: 'TRUE'
            REPLACE_ENV_VARIABLE_PREFIX: 'CIV'

            INIT_MEMORY: '{{setting.minecraft.resources.shard_memory}}'
            MAX_MEMORY: '{{setting.minecraft.resources.shard_memory}}'
            USE_MEOWICE_FLAGS: 'TRUE'
            STOP_DURATION: 3600

            CIV_SECUREBOOT_ENABLE: 'true'
            CIV_SERVER_NAME: prod-server
            # The name this shard owns ground and player data under; must match the proxy's server list
            CIV_SHARD_NAME: northeast
{% if setting.minecraft.whitelist %}
            ENABLE_WHITELIST: 'true'
            CIV_WHITELIST: 'true'
{% else %}
            ENABLE_WHITELIST: 'false'
            CIV_WHITELIST: 'false'
{% endif %}

            CIV_WORLD_GENERATOR: Terra:CIVMC
            CIV_WORDBANK_SEED: '{{secret.minecraft.wordbank_seed}}'
            CIV_HIDDENORE_DENSITY_SEED: '{{ secret.minecraft.zorweth_hiddenore_density_seed }}'
            CIV_HIDDENORE_HEIGHT_SEED: '{{ secret.minecraft.zorweth_hiddenore_height_seed }}'

            CIV_MYSQL_HOST: minecraft_mariadb
            CIV_MYSQL_USERNAME: '{{secret.minecraft.mysql.username}}'
            CIV_MYSQL_PASSWORD: '{{secret.minecraft.mysql.password}}'

            CIV_POSTGRES_HOST: minecraft_postgres
            CIV_POSTGRES_USERNAME: '{{secret.minecraft.postgres.username}}'
            CIV_POSTGRES_PASSWORD: '{{secret.minecraft.postgres.password}}'

            CIV_DATABASE_PREFIX: ''

            CIV_RABBITMQ_HOST: minecraft_rabbitmq
            CIV_RABBITMQ_USERNAME: rabbitmq
            CIV_RABBITMQ_PASSWORD: '{{secret.minecraft.rabbitmq.password}}'

            CIV_WATCHDOG_TIMEOUT_TIME: 60
            CIV_FORWARDING_SECRET: '{{secret.minecraft.forwarding_secret}}'

            JVM_OPTS: '-agentpath:./libti.so'
        volumes:
            # Persistence
            - /opt/stacks/minecraft/northeast-data:/data
            # Config & Plugins
            - /opt/stacks/minecraft/paper-config:/config
            - /opt/stacks/minecraft/paper-plugins:/plugins

        deploy:
            placement:
                constraints: [node.role == manager]
            resources:
                limits:
                    memory: '{{setting.minecraft.resources.shard_memory_limit}}'

    southeast:
        image: itzg/minecraft-server:stable-java25
        restart: unless-stopped
        tty: true
        stdin_open: true
        stop_grace_period: 60m
        networks:
            - minecraft_default
        environment:
            TYPE: 'paper'
            VERSION: '1.21.11'
            EULA: 'TRUE'
            PAPER_DOWNLOAD_URL: 'https://api.leafmc.one/v2/projects/leaf/versions/1.21.11/builds/166/downloads/leaf-1.21.11-166.jar'

            REMOVE_OLD_MODS: 'TRUE'
            COPY_CONFIG_DEST: '/data'
            SYNC_SKIP_NEWER_IN_DESTINATION: 'false'
            REPLACE_ENV_DURING_SYNC: 'TRUE'
            REPLACE_ENV_VARIABLE_PREFIX: 'CIV'

            INIT_MEMORY: '{{setting.minecraft.resources.shard_memory}}'
            MAX_MEMORY: '{{setting.minecraft.resources.shard_memory}}'
            USE_MEOWICE_FLAGS: 'TRUE'
            STOP_DURATION: 3600

            CIV_SECUREBOOT_ENABLE: 'true'
            CIV_SERVER_NAME: prod-server
            # The name this shard owns ground and player data under; must match the proxy's server list
            CIV_SHARD_NAME: southeast
{% if setting.minecraft.whitelist %}
            ENABLE_WHITELIST: 'true'
            CIV_WHITELIST: 'true'
{% else %}
            ENABLE_WHITELIST: 'false'
            CIV_WHITELIST: 'false'
{% endif %}

            CIV_WORLD_GENERATOR: Terra:CIVMC
            CIV_WORDBANK_SEED: '{{secret.minecraft.wordbank_seed}}'
            CIV_HIDDENORE_DENSITY_SEED: '{{ secret.minecraft.zorweth_hiddenore_density_seed }}'
            CIV_HIDDENORE_HEIGHT_SEED: '{{ secret.minecraft.zorweth_hiddenore_height_seed }}'

            CIV_MYSQL_HOST: minecraft_mariadb
            CIV_MYSQL_USERNAME: '{{secret.minecraft.mysql.username}}'
            CIV_MYSQL_PASSWORD: '{{secret.minecraft.mysql.password}}'

            CIV_POSTGRES_HOST: minecraft_postgres
            CIV_POSTGRES_USERNAME: '{{secret.minecraft.postgres.username}}'
            CIV_POSTGRES_PASSWORD: '{{secret.minecraft.postgres.password}}'

            CIV_DATABASE_PREFIX: ''

            CIV_RABBITMQ_HOST: minecraft_rabbitmq
            CIV_RABBITMQ_USERNAME: rabbitmq
            CIV_RABBITMQ_PASSWORD: '{{secret.minecraft.rabbitmq.password}}'

            CIV_WATCHDOG_TIMEOUT_TIME: 60
            CIV_FORWARDING_SECRET: '{{secret.minecraft.forwarding_secret}}'

            JVM_OPTS: '-agentpath:./libti.so'
        volumes:
            # Persistence
            - /opt/stacks/minecraft/southeast-data:/data
            # Config & Plugins
            - /opt/stacks/minecraft/paper-config:/config
            - /opt/stacks/minecraft/paper-plugins:/plugins

        deploy:
            placement:
                constraints: [node.role == manager]
            resources:
                limits:
                    memory: '{{setting.minecraft.resources.shard_memory_limit}}'

    zorweth:
        image: itzg/minecraft-server:stable-java25
        restart: unless-stopped
        tty: true
        stdin_open: true
        stop_grace_period: 60m
        networks:
            - minecraft_default
        environment:
            TYPE: 'paper'
            VERSION: '1.21.11'
            EULA: 'TRUE'
            PAPER_DOWNLOAD_URL: 'https://api.leafmc.one/v2/projects/leaf/versions/1.21.11/builds/166/downloads/leaf-1.21.11-166.jar'

            REMOVE_OLD_MODS: 'TRUE'
            COPY_CONFIG_DEST: '/data'
            SYNC_SKIP_NEWER_IN_DESTINATION: 'false'
            REPLACE_ENV_DURING_SYNC: 'TRUE'
            REPLACE_ENV_VARIABLE_PREFIX: 'CIV'

            INIT_MEMORY: '{{setting.minecraft.resources.zorweth_memory}}'
            MAX_MEMORY: '{{setting.minecraft.resources.zorweth_memory}}'
            USE_MEOWICE_FLAGS: 'TRUE'
            STOP_DURATION: 3600

            CIV_SECUREBOOT_ENABLE: 'true'
            CIV_SERVER_NAME: prod-server
            # The name this shard owns ground and player data under; must match the proxy's server
            # list. Zorweth is a shard with no neighbour - it owns its own map at z = -20000 and has
            # no border to anywhere - so what this buys it is the network's shared player data
            CIV_SHARD_NAME: zorweth
{% if setting.minecraft.zorweth_whitelist %}
            ENABLE_WHITELIST: 'true'
            CIV_WHITELIST: 'true'
{% else %}
            ENABLE_WHITELIST: 'false'
            CIV_WHITELIST: 'false'
{% endif %}

            CIV_WORDBANK_SEED: '{{secret.minecraft.wordbank_seed}}'

            CIV_MYSQL_HOST: minecraft_mariadb
            CIV_MYSQL_USERNAME: '{{secret.minecraft.mysql.username}}'
            CIV_MYSQL_PASSWORD: '{{secret.minecraft.mysql.password}}'

            CIV_POSTGRES_HOST: minecraft_postgres
            CIV_POSTGRES_USERNAME: '{{secret.minecraft.postgres.username}}'
            CIV_POSTGRES_PASSWORD: '{{secret.minecraft.postgres.password}}'

            CIV_DATABASE_PREFIX: 'zorweth_'

            CIV_RABBITMQ_HOST: minecraft_rabbitmq
            CIV_RABBITMQ_USERNAME: rabbitmq
            CIV_RABBITMQ_PASSWORD: '{{secret.minecraft.rabbitmq.password}}'

            CIV_WATCHDOG_TIMEOUT_TIME: 60
            CIV_FORWARDING_SECRET: '{{secret.minecraft.forwarding_secret}}'

            JVM_OPTS: '-agentpath:./libti.so'
        volumes:
            # Persistence
            - /opt/stacks/minecraft/zorweth-data:/data
            # Config & Plugins
            - /opt/stacks/minecraft/zorweth-config:/config
            - /opt/stacks/minecraft/zorweth-plugins:/plugins
        deploy:
            placement:
                constraints: [node.role == manager]
            resources:
                limits:
                    memory: '{{setting.minecraft.resources.zorweth_memory_limit}}'

    pvp:
        image: itzg/minecraft-server:stable-java25
        restart: unless-stopped
        tty: true
        stdin_open: true
        stop_grace_period: 60m
        networks:
            - minecraft_default
        ports:
            - target: 8193
              published: 8193
              protocol: tcp
              mode: host
        environment:
            TYPE: 'paper'
            VERSION: '1.21.11'
            EULA: 'TRUE'
            PAPER_CUSTOM_JAR: 'asp-server.jar'

            REMOVE_OLD_MODS: 'TRUE'
            COPY_CONFIG_DEST: '/data'
            SYNC_SKIP_NEWER_IN_DESTINATION: 'false'
            REPLACE_ENV_DURING_SYNC: 'TRUE'
            REPLACE_ENV_VARIABLE_PREFIX: 'CIV'

            INIT_MEMORY: '{{setting.minecraft.resources.pvp_memory}}'
            MAX_MEMORY: '{{setting.minecraft.resources.pvp_memory}}'
            USE_MEOWICE_FLAGS: 'TRUE'
            STOP_DURATION: 3600

            CIV_SERVER_NAME: prod-server
{% if setting.minecraft.pvp_whitelist %}
            ENABLE_WHITELIST: 'true'
            CIV_WHITELIST: 'true'
{% else %}
            ENABLE_WHITELIST: 'false'
            CIV_WHITELIST: 'false'
{% endif %}

            CIV_WORLD_GENERATOR: VoidWorld

            CIV_MYSQL_HOST: minecraft_mariadb
            CIV_MYSQL_USERNAME: '{{secret.minecraft.mysql.username}}'
            CIV_MYSQL_PASSWORD: '{{secret.minecraft.mysql.password}}'

            CIV_POSTGRES_HOST: minecraft_postgres
            CIV_POSTGRES_USERNAME: '{{secret.minecraft.postgres.username}}'
            CIV_POSTGRES_PASSWORD: '{{secret.minecraft.postgres.password}}'

            CIV_DATABASE_PREFIX: 'pvp_'

            CIV_RABBITMQ_HOST: minecraft_rabbitmq
            CIV_RABBITMQ_USERNAME: rabbitmq
            CIV_RABBITMQ_PASSWORD: '{{secret.minecraft.rabbitmq.password}}'

            CIV_WATCHDOG_TIMEOUT_TIME: 60
            CIV_FORWARDING_SECRET: '{{secret.minecraft.forwarding_secret}}'

        volumes:
            # Persistence
            - /opt/stacks/minecraft/pvp-data:/data
            # Config & Plugins
            - /opt/stacks/minecraft/pvp-config:/config
            - /opt/stacks/minecraft/pvp-plugins:/plugins

        deploy:
            placement:
                constraints: [node.role == manager]
            resources:
                limits:
                    memory: '{{setting.minecraft.resources.pvp_memory_limit}}'

    kira:
        image: ghcr.io/civmc/kira:latest
        restart: unless-stopped
        tty: true
        stdin_open: true
        networks:
            - minecraft_default
        deploy:
            placement:
                constraints: [node.role == manager]

    mariadb:
        image: mariadb:10.7.1
        restart: unless-stopped
        command: --max-connections 1500 --max-allowed-packet 1073741824
        networks:
            - monitoring
            - minecraft_default
        environment:
            MYSQL_USER: minecraft
            MYSQL_PASSWORD: '{{secret.minecraft.mysql.password}}'
            MYSQL_ROOT_PASSWORD: '{{secret.minecraft.mysql.root_password}}'
        volumes:
            - /opt/stacks/minecraft/mariadb-data:/var/lib/mysql
        deploy:
            placement:
                constraints: [node.role == manager]

    postgres:
        image: timescale/timescaledb:2.10.3-pg14
        restart: unless-stopped
        command: postgres -c 'max_connections=1500'
        networks:
            - monitoring
            - minecraft_default
        healthcheck:
            test: ["CMD-SHELL", "pg_isready"]
            interval: 10s
            timeout: 5s
            retries: 5
        environment:
            POSTGRES_USER: minecraft
            POSTGRES_PASSWORD: '{{secret.minecraft.postgres.password}}'
        volumes:
            - /opt/stacks/minecraft/postgres-data:/var/lib/postgresql/data
        deploy:
            placement:
                constraints: [node.role == manager]

    rabbitmq:
        image: rabbitmq:3.9.16-management
        restart: unless-stopped
        networks:
            - minecraft_default
        healthcheck:
            test: ["CMD", "rabbitmq-diagnostics", "ping"]
            interval: 60s
            timeout: 10s
            retries: 5
        environment:
            RABBITMQ_DEFAULT_USER: rabbitmq
            RABBITMQ_DEFAULT_PASS: '{{secret.minecraft.rabbitmq.password}}'
        deploy:
            placement:
                constraints: [node.role == manager]

networks:
    minecraft_default:
    traefik-public:
        external: true
    monitoring:
        external: true
